{
  "name": "homecinema",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "buffer": "^6.0.3",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-udp": "^4.1.7"
  },
  "devDependencies": {
    "@types/events": "^3.0.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:usb": "adb reverse tcp:8081 tcp:8081 && expo start --dev-client --localhost"
  },
  "private": true,
  "overrides": {
